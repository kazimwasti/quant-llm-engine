# Keep this file credential-free. Copy it to .env only on the paper-trading host.
# This project must remain in shadow/paper mode until operational validation passes.
TRADING_MODE=shadow
PAPER_TRADING=true
OPERATION_JOURNAL=data/safety-state.json

# Required only by the TopstepX/ProjectX integration. Never commit real values.
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
TOPSTEPX_ACCOUNT_ID=
TOPSTEPX_BASE_URL=https://api.topstepx.com
